# Python
__pycache__/
*.pyc

# Third-party vendor packages (Plustek macOS/Windows drivers: large, not ours to redistribute; the tools read
# vendor/windows_s400/extracted/Data/74RU/cism603.fw from here, so keep a local copy)
vendor/

# 8051 compiler intermediates (regenerated by `make -C firmware`); the .ihx/.hex/.bin images are kept
firmware/*.rel
firmware/*.lk
firmware/*.lst
firmware/*.map
firmware/*.mem
firmware/*.rst
firmware/*.sym
firmware/*.asm

# Automatic RAM backups written by `gt6816_ctl.py load --backup` and scan images from experiments
captures/ram/gt6816_m1_pre_load_*.bin
captures/scans/
!captures/ram/gt6816_m1_pre_load_064653.bin
